  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center>EPISODIO I\nFINAL EFECTOS VISUALES</align>\n\nEs un per\xEDodo
    de caos y guerra gal\xE1ctica. La implacable flota enemiga ha lanzado un ataque
    sorpresa sobre la \xF3rbita del planeta Zefiro, bloqueando las rutas comerciales
    e intentando apoderarse de sus invaluables refiner\xEDas de energ\xEDa.\n\nMientras
    las naves de combate de la resistencia libran una batalla desesperada en el g\xE9lido
    vac\xEDo del espacio, un gigantesco crucero estelar enemigo se prepara para aniquilar
    las defensas del planeta con su armamento pesado.\n\nEn un \xFAltimo intento
    por salvar el sistema, un solitario infiltrado ha logrado burlar los escudos
    de seguridad y adentrarse en la sala de comando del mism\xEDsimo crucero. Su
    misi\xF3n es clara: tomar el control de los sistemas inform\xE1ticos y disparar
    el mega l\xE1ser principal contra la propia flota enemiga antes de que sea demasiado
    tarde..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 065494bfb02403b42850feaef314b46a, type: 2}
  m_sharedMaterial: {fileID: 8148637461528231759, guid: 065494bfb02403b42850feaef314b46a,

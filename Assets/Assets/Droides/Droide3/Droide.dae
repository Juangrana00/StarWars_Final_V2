              <instance_material symbol="defaultMaterial" target="#Material" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#root" />
  </scene>
</COLLADA>
